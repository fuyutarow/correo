#!/bin/sh
# shim: hook-entry
# commit gate の中身は mise.toml の `hook:pre-commit`（契約 verb の depends のみ）が宣言する。
# version-guard は `lint:version` として lint に入っている。`--jobs 1`: mise 2026.9.12 の並列
# scheduler は失敗 dep で hang し SIGTERM も無視する（3/6 実測）。
command -v mise > /dev/null 2>&1 || {
  echo "pre-commit: mise not on PATH; gate skipped (run 'mise run hook:pre-commit' manually)" >&2
  exit 0
}
exec mise run --jobs 1 hook:pre-commit
